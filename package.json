{
  "name": "trestlejs-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm build && pnpm typecheck && vitest run",
    "check:generated": "node scripts/check-generated-project.mjs",
    "check:upgrade": "node scripts/check-adjacent-upgrade.mjs",
    "check:beta-upgrade": "TRESTLE_PUBLISHED_BETA_UPGRADE=1 node scripts/check-adjacent-upgrade.mjs",
    "release:check": "node scripts/check-release.mjs",
    "release:pack": "node scripts/pack-release.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}

{
  "name": "trestlejs",
  "version": "0.1.0-alpha.43",
  "description": "The command-line interface for building and operating TrestleJS applications.",
  "license": "MIT",
  "author": {
    "name": "Greg Mushen",
    "email": "greg.mushen@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gregmushen/trestlejs.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/gregmushen/trestlejs#readme",
  "bugs": {
    "url": "https://github.com/gregmushen/trestlejs/issues"
  },
  "keywords": ["trestlejs", "cloudflare", "cli", "typescript", "application-framework"],
  "type": "module",
  "bin": {
    "trestle": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "LICENSE", "README.md"],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@trestlejs/core": "workspace:*",
    "commander": "15.0.0",
    "yaml": "2.9.1"
  }
}

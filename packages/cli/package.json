{
  "name": "trestlejs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "trestle": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@trestlejs/core": "workspace:*",
    "commander": "15.0.0",
    "yaml": "2.9.1"
  }
}

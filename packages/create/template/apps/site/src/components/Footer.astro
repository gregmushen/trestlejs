---
import { site } from "../config/site";
---

<footer class="mt-24 border-t border-border bg-surface">
  <div class="page-shell grid gap-10 py-14 md:grid-cols-[2fr_1fr_1fr_1fr]">
    <div><p class="font-display text-2xl font-semibold">{site.name}</p><p class="mt-3 max-w-sm text-sm leading-6 text-muted">{site.description}</p></div>
    <div><p class="text-sm font-semibold">Product</p><ul class="mt-3 space-y-2 text-sm text-muted"><li><a class="hover:text-primary" href="/features">Features</a></li><li><a class="hover:text-primary" href="/pricing">Pricing</a></li></ul></div>
    <div><p class="text-sm font-semibold">Company</p><ul class="mt-3 space-y-2 text-sm text-muted"><li><a class="hover:text-primary" href="/about">About</a></li></ul></div>
    <div><p class="text-sm font-semibold">Legal</p><ul class="mt-3 space-y-2 text-sm text-muted"><li><a class="hover:text-primary" href="/privacy">Privacy</a></li><li><a class="hover:text-primary" href="/terms">Terms</a></li></ul></div>
  </div>
  <div class="page-shell border-t border-border py-6 text-sm text-muted">© {new Date().getFullYear()} {site.name}. Starter content—replace before launch.</div>
</footer>

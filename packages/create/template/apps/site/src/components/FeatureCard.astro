---
interface Props { eyebrow: string; title: string; description: string }
const { eyebrow, title, description } = Astro.props;
---

<article class="surface-card p-7">
  <p class="text-xs font-bold uppercase tracking-[0.18em] text-primary">{eyebrow}</p>
  <h3 class="mt-3 text-xl font-semibold">{title}</h3>
  <p class="mt-3 leading-7 text-muted">{description}</p>
</article>

---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Privacy" description="Starter privacy-policy structure for Southwind.">
  <article class="page-shell py-20"><div class="mx-auto max-w-3xl"><p class="text-sm font-bold uppercase tracking-[0.2em] text-primary">Legal template</p><h1 class="display-title mt-5 text-5xl font-semibold">Privacy</h1><div class="mt-10 space-y-8 leading-7 text-muted"><p class="rounded-2xl border border-border bg-surface p-5 text-foreground"><strong>Replace this page before launch.</strong> It is starter structure, not legal advice or a production-ready privacy policy.</p><section><h2 class="text-xl font-semibold text-foreground">Information you collect</h2><p class="mt-3">Describe account, usage, billing, and support information relevant to your actual product.</p></section><section><h2 class="text-xl font-semibold text-foreground">How information is used</h2><p class="mt-3">Explain the specific product, security, support, and legal purposes that apply.</p></section><section><h2 class="text-xl font-semibold text-foreground">Retention and choices</h2><p class="mt-3">Document real retention periods, deletion paths, regional rights, and contact information.</p></section></div></div></article>
</SiteLayout>

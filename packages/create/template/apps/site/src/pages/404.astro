---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Page not found" description="The requested Southwind page could not be found.">
  <section class="page-shell py-28 text-center"><p class="text-sm font-bold uppercase tracking-[0.2em] text-primary">404</p><h1 class="display-title mt-5 text-5xl font-semibold">Page not found</h1><p class="mt-5 text-lg text-muted">We couldn't find the page you're looking for.</p><a class="mt-8 inline-block rounded-xl bg-primary px-6 py-3 font-semibold text-white hover:bg-primary-strong" href="/">Return home</a></section>
</SiteLayout>

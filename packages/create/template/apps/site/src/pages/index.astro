---
import FeatureCard from "../components/FeatureCard.astro";
import PricingCard from "../components/PricingCard.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { appLink, site } from "../config/site";

const appUrl = import.meta.env.APP_URL ?? "http://localhost:42069";
---

<SiteLayout>
  <section class="page-shell grid items-center gap-12 py-20 lg:grid-cols-[1.15fr_0.85fr] lg:py-28">
    <div>
      <p class="text-sm font-bold uppercase tracking-[0.2em] text-primary">Collaborative operations</p>
      <h1 class="display-title mt-5 max-w-4xl text-5xl font-semibold leading-[1.02] tracking-tight sm:text-7xl">{site.tagline}</h1>
      <p class="mt-7 max-w-2xl text-lg leading-8 text-muted">{site.description}</p>
      <div class="mt-9 flex flex-wrap gap-4"><a class="rounded-xl bg-primary px-6 py-3 font-semibold text-white transition hover:bg-primary-strong" href={appLink("/sign-up", appUrl)}>Get started</a><a class="rounded-xl border border-border bg-surface px-6 py-3 font-semibold hover:border-primary" href="/pricing">View pricing</a></div>
    </div>
    <div class="surface-card relative overflow-hidden p-6 sm:p-8">
      <div class="absolute right-0 top-0 h-36 w-36 rounded-full bg-primary/15 blur-3xl"></div>
      <p class="text-sm font-semibold text-muted">Today at Southwind</p>
      <div class="mt-6 space-y-4">
        <div class="rounded-2xl border border-border bg-background p-5"><p class="text-xs font-bold uppercase tracking-wider text-primary">Workflow</p><p class="mt-2 font-semibold">Customer onboarding</p><p class="mt-1 text-sm text-muted">8 of 10 steps complete</p></div>
        <div class="grid grid-cols-2 gap-4"><div class="rounded-2xl border border-border bg-surface p-5"><p class="text-3xl font-semibold">24</p><p class="mt-1 text-sm text-muted">Open tasks</p></div><div class="rounded-2xl border border-border bg-surface p-5"><p class="text-3xl font-semibold">96%</p><p class="mt-1 text-sm text-muted">On time</p></div></div>
      </div>
    </div>
  </section>

  <section class="page-shell py-16" aria-labelledby="value-heading"><p class="text-sm font-bold uppercase tracking-[0.2em] text-primary">One calm place to work</p><h2 id="value-heading" class="display-title mt-4 max-w-3xl text-4xl font-semibold sm:text-5xl">Structure where it helps. Flexibility where it matters.</h2><div class="mt-10 grid gap-5 md:grid-cols-3"><FeatureCard eyebrow="Organize" title="Work stays understandable" description="Give every project a clear home, owner, status, and next step without turning your process into bureaucracy." /><FeatureCard eyebrow="Automate" title="Routine work moves itself" description="Use dependable workflows for handoffs, reminders, approvals, and the repetitive work nobody should chase manually." /><FeatureCard eyebrow="Align" title="Everyone sees the same truth" description="Keep decisions, progress, and operational signals connected so teams spend less time asking for updates." /></div></section>

  <section class="page-shell py-16"><div class="surface-card grid gap-10 p-8 sm:p-12 lg:grid-cols-3"><div><p class="text-sm font-bold uppercase tracking-wider text-primary">01 · Capture</p><h3 class="mt-3 text-xl font-semibold">Bring work into focus</h3><p class="mt-3 leading-7 text-muted">Start with the outcomes, people, and information that matter.</p></div><div><p class="text-sm font-bold uppercase tracking-wider text-primary">02 · Coordinate</p><h3 class="mt-3 text-xl font-semibold">Make the process visible</h3><p class="mt-3 leading-7 text-muted">Turn tribal knowledge into lightweight, repeatable workflows.</p></div><div><p class="text-sm font-bold uppercase tracking-wider text-primary">03 · Improve</p><h3 class="mt-3 text-xl font-semibold">Learn from real operations</h3><p class="mt-3 leading-7 text-muted">See where work slows down and improve the system together.</p></div></div></section>

  <section class="page-shell py-16" aria-labelledby="pricing-preview"><div class="flex flex-wrap items-end justify-between gap-5"><div><p class="text-sm font-bold uppercase tracking-[0.2em] text-primary">Simple pricing</p><h2 id="pricing-preview" class="display-title mt-4 text-4xl font-semibold sm:text-5xl">Start small. Grow without re-platforming.</h2></div><a class="font-semibold text-primary hover:text-primary-strong" href="/pricing">See every plan →</a></div><div class="mt-10 grid gap-5 md:grid-cols-2"><PricingCard name="Starter" price="$0" description="For individuals and small teams getting started." features={["1 workspace", "Up to 3 members", "Core features"]} href={appLink("/sign-up?plan=starter", appUrl)} cta="Start free" /><PricingCard name="Pro" price="$29" cadence="/ month" description="For growing teams ready to automate more work." features={["Unlimited members", "Advanced workflows", "Additional controls"]} href={appLink("/sign-up?plan=pro", appUrl)} cta="Start free" featured /></div></section>

  <section class="page-shell py-16"><div class="overflow-hidden rounded-[2rem] bg-foreground px-7 py-14 text-center text-white sm:px-12"><p class="text-sm font-bold uppercase tracking-[0.2em] text-white/65">Make work feel lighter</p><h2 class="display-title mx-auto mt-4 max-w-3xl text-4xl font-semibold sm:text-5xl">A better operating rhythm starts with one clear place.</h2><a class="mt-8 inline-block rounded-xl bg-white px-6 py-3 font-semibold text-foreground transition hover:bg-background" href={appLink("/sign-up", appUrl)}>Get started with Southwind</a></div></section>
</SiteLayout>

{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The optional platform admin API: a separately deployed Worker with its own
  // origin, cookies, and database login (granted trestle_platform only).
  "name": "__TRESTLE_PROJECT_NAME__-admin",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "APP_ENV": "local", "ADMIN_ORIGIN": "http://localhost:42070", "ADMIN_API_URL": "http://localhost:8788", "API_URL": "http://localhost:8787", "APP_URL": "http://localhost:42069" },
  "secrets": { "required": ["DATABASE_URL", "DATABASE_DRIVER", "BETTER_AUTH_SECRET"] },
  "env": {
    "preview": {
      "name": "__TRESTLE_PROJECT_NAME__-admin-preview",
      "vars": { "APP_ENV": "preview", "ADMIN_ORIGIN": "CHANGE_ME", "ADMIN_API_URL": "CHANGE_ME", "API_URL": "CHANGE_ME", "APP_URL": "CHANGE_ME" },
      "secrets": { "required": ["DATABASE_URL", "DATABASE_DRIVER", "DATABASE_ADMIN_URL", "BETTER_AUTH_SECRET"] }
    },
    "staging": {
      "name": "__TRESTLE_PROJECT_NAME__-admin-staging",
      "vars": { "APP_ENV": "staging", "ADMIN_ORIGIN": "CHANGE_ME", "ADMIN_API_URL": "CHANGE_ME", "API_URL": "CHANGE_ME", "APP_URL": "CHANGE_ME" },
      "secrets": { "required": ["DATABASE_URL", "DATABASE_DRIVER", "DATABASE_ADMIN_URL", "BETTER_AUTH_SECRET"] }
    },
    "production": {
      "name": "__TRESTLE_PROJECT_NAME__-admin",
      "vars": { "APP_ENV": "production", "ADMIN_ORIGIN": "CHANGE_ME", "ADMIN_API_URL": "CHANGE_ME", "API_URL": "CHANGE_ME", "APP_URL": "CHANGE_ME" },
      "secrets": { "required": ["DATABASE_URL", "DATABASE_DRIVER", "DATABASE_ADMIN_URL", "BETTER_AUTH_SECRET"] }
    }
  }
}

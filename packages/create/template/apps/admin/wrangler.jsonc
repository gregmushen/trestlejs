{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The platform admin API is a separately deployed Worker with its own origin,
  // session posture, and database login (granted trestle_platform only).
  "name": "__TRESTLE_PROJECT_NAME__-admin",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  // Applies scheduled subscription changes (see applyDueSubscriptionChanges).
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "APP_ENV": "local",
    "ADMIN_ORIGIN": "http://localhost:42070",
    "ARTIFACT_RETENTION_DAYS": "30"
  },
  "secrets": { "required": ["DATABASE_URL", "PLATFORM_DATABASE_URL", "DATABASE_DRIVER", "BETTER_AUTH_SECRET"] },
  "env": {
    "preview": { "name": "__TRESTLE_PROJECT_NAME__-admin-preview", "vars": { "APP_ENV": "preview", "ADMIN_ORIGIN": "CHANGE_ME", "ARTIFACT_RETENTION_DAYS": "30" } },
    "staging": { "name": "__TRESTLE_PROJECT_NAME__-admin-staging", "vars": { "APP_ENV": "staging", "ADMIN_ORIGIN": "CHANGE_ME", "ARTIFACT_RETENTION_DAYS": "30" } },
    "production": { "name": "__TRESTLE_PROJECT_NAME__-admin", "vars": { "APP_ENV": "production", "ADMIN_ORIGIN": "CHANGE_ME", "ARTIFACT_RETENTION_DAYS": "30" } }
  }
}

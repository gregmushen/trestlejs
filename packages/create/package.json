{
  "name": "create-trestlejs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "create-trestlejs": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "template"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@trestlejs/core": "workspace:*",
    "trestlejs": "workspace:*",
    "commander": "15.0.0"
  }
}

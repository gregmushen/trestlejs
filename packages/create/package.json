{
  "name": "create-trestlejs",
  "version": "0.1.0-alpha.110",
  "description": "Create a conventional TrestleJS application.",
  "license": "MIT",
  "author": {
    "name": "Greg Mushen",
    "email": "greg.mushen@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gregmushen/trestlejs.git",
    "directory": "packages/create"
  },
  "homepage": "https://github.com/gregmushen/trestlejs#readme",
  "bugs": {
    "url": "https://github.com/gregmushen/trestlejs/issues"
  },
  "keywords": ["trestlejs", "create", "cloudflare", "typescript", "application-framework"],
  "type": "module",
  "bin": {
    "create-trestlejs": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "template", "LICENSE", "README.md"],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@trestlejs/core": "workspace:*",
    "trestlejs": "workspace:*",
    "commander": "15.0.0"
  }
}
